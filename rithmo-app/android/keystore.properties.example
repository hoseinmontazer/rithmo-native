# Release signing credentials for the Rithmo Android app.
#
# Copy this file to `keystore.properties` (same directory) and fill in real
# values. `keystore.properties` is gitignored — never commit it, and never
# commit the .keystore file it points to.
#
# If you don't have a release keystore yet, generate one (do this ONCE, then
# store the .keystore file and its passwords in your team's secret manager —
# losing it means you can never publish an update to the same app listing):
#
#   keytool -genkeypair -v -storetype PKCS12 \
#     -keystore rithmo-release.keystore \
#     -alias rithmo-release-key \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# Place the resulting .keystore file under android/app/ (or reference it
# with a path relative to android/app/ below), then fill in:

RELEASE_STORE_FILE=rithmo-release.keystore
RELEASE_STORE_PASSWORD=changeme
RELEASE_KEY_ALIAS=rithmo-release-key
RELEASE_KEY_PASSWORD=changeme

# CI alternative: instead of committing/copying this file to a build agent,
# set these four values as the environment variables
# RITHMO_RELEASE_STORE_FILE, RITHMO_RELEASE_STORE_PASSWORD,
# RITHMO_RELEASE_KEY_ALIAS, RITHMO_RELEASE_KEY_PASSWORD (and place the
# keystore file at the path RITHMO_RELEASE_STORE_FILE points to before
# running the build). android/app/build.gradle reads keystore.properties
# first and falls back to these environment variables when the file is
# absent.
